# AI Providers
ANTHROPIC_API_KEY=your-anthropic-key-here
GOOGLE_API_KEY=your-google-key-here

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workmain
DB_USER=workmain_user
DB_PASSWORD=your-secure-password

# Integrations (will be set during setup wizard)
# CLOCKIFY_API_KEY=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_TENANT_ID=
# Slack Integration (Phase 8)
# SLACK_BOT_TOKEN=
# SLACK_DEFAULT_CHANNEL=
# SLACK_SOCKET_TOKEN=xapp-your-app-level-token-here

# Google Drive Integration (Phase 7)
GDRIVE_TIMECARDS_ROOT=

# User Information for Reporting
USER_FULL_NAME=

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Phase 10 — Notification & Scheduling
WORKMAIN_STATE_DIR=~/.workmain
WORKMAIN_EXPECTED_HOURS=8.0
WORKMAIN_NOTIFY_ENABLED=true
WORKMAIN_NOTIFY_METHOD=terminal

# Phase 11 — Client Foundation
WORKMAIN_DEFAULT_CLIENT=     # Name of your first client (used by initial data migration)
