#!/usr/bin/env bash
#
# commit-msg — enforce the conventional-commit subject format.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# The standard this enforces lives in docs/DEVELOPMENT_STANDARDS.md §2.4.
# This hook checks format only; it cannot tell you a scope is wrong or a
# description is useless.

set -uo pipefail

msg_file="$1"
subject="$(head -n1 "$msg_file")"

# git invokes commit-msg for `git merge` as well as `git commit`. Merge,
# revert, and fixup/squash subjects are generated by git itself and are not
# conventional commits — exempt them or every PR merge would be rejected.
if [ -e "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
    exit 0
fi

case "$subject" in
    Merge\ *|Revert\ *|fixup!*|squash!*|amend!*) exit 0 ;;
esac

# Comment-only or empty message: let git handle the abort itself.
if [ -z "${subject//[[:space:]]/}" ] || [ "${subject:0:1}" = "#" ]; then
    exit 0
fi

if printf '%s' "$subject" \
    | grep -qE '^(feat|fix|refactor|chore|docs|test)(\([a-z0-9._-]+\))?: .+'; then
    exit 0
fi

cat >&2 <<'HEADER'

✗ Commit rejected — the subject line does not match the required format.

  Required:  <type>(<scope>): <description>
  Types:     feat  fix  refactor  chore  docs  test
  Scope:     optional; lowercase letters, digits, . _ -

  Your subject was:
HEADER

printf '    %s\n' "$subject" >&2

cat >&2 <<'FOOTER'

  Valid examples:
    feat(notes): add carry-forward tag hook
    fix(eod): stop the weekly report double-send
    docs(standards): consolidate the standards documents

  Gate context belongs in the body, never the subject:

    feat(notes): converge the note write path

    Gate 3 of 7. Files changed, decisions made, expected test count.

  Full standard: docs/DEVELOPMENT_STANDARDS.md §2.4
  Do not bypass this with --no-verify — that is prohibited by the same standard.

FOOTER

exit 1
