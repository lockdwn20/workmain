{
  "version": "1.3",
  "description": "WorkmAIn AI Provider Configuration",
  "last_updated": "20260903",
  "providers": {
    "claude": {
      "enabled": true,
      "accepts": ["system_prompt"],
      "model": "claude-sonnet-5",
      "api_key_env": "ANTHROPIC_API_KEY",
      "cost_per_1k_prompt_tokens": 0.002,
      "cost_per_1k_completion_tokens": 0.01,
      "cost_structure": "$2/MTok prompt, $10/MTok completion",
      "rate_limit_rpm": 50,
      "timeout_seconds": 60,
      "retry_attempts": 3,
      "retry_delay_seconds": 1.0,
      "notes": "Claude Sonnet 5 - fallback provider for all report types and note condensation. Request payload policy (thinking disabled, no sampling) lives in config/providers/claude/settings.json."
    },
    "gemini": {
      "enabled": true,
      "accepts": ["system_prompt"],
      "model": "gemini-3.6-flash",
      "api_key_env": "GOOGLE_API_KEY",
      "cost_per_1k_prompt_tokens": 0.00075,
      "cost_per_1k_completion_tokens": 0.00375,
      "cost_structure": "$.75/MTok prompt, $3.75/MTok completion",
      "rate_limit_rpm": 60,
      "timeout_seconds": 60,
      "retry_attempts": 3,
      "retry_delay_seconds": 1.0,
      "notes": "Gemini 3.6 Flash - $0.75/MTok input, $3.75/MTok output"
    },
    "ollama": {
      "enabled": true,
      "accepts": ["modelfile", "raw_prompt"],
      "model": "workmain-intent:latest",
      "host": "workmain-ollama.lab.haloschaos.com",
      "port": 11434,
      "timeout": 30,
      "cost_structure": "Local \u2014 no API cost"
    }
  },
  "report_types": {
    "daily_internal": {
      "instructions": "system_prompt",
      "primary_provider": "claude",
      "fallback_provider": "gemini",
      "fallback_mode": "auto",
      "max_cost_per_report": 1.0,
      "max_tokens": 16000,
      "description": "Daily internal status report"
    },
    "weekly_client": {
      "instructions": "system_prompt",
      "primary_provider": "claude",
      "fallback_provider": "gemini",
      "fallback_mode": "auto",
      "max_cost_per_report": 2.0,
      "max_tokens": 16000,
      "description": "Weekly client status report"
    },
    "monthly_executive": {
      "instructions": "system_prompt",
      "primary_provider": "claude",
      "fallback_provider": "gemini",
      "fallback_mode": "auto",
      "max_cost_per_report": 2.0,
      "max_tokens": 16000,
      "description": "Monthly executive report"
    },
    "note_condensation": {
      "instructions": "system_prompt",
      "primary_provider": "gemini",
      "fallback_provider": "claude",
      "fallback_mode": "auto",
      "max_cost_per_report": 0.1,
      "max_tokens": 4000,
      "description": "Condense meeting notes for Clockify"
    }
  },
  "application_functions": {
    "daemon_narration": {
      "instructions": "system_prompt",
      "primary_provider": "claude",
      "fallback_provider": "gemini",
      "fallback_mode": "auto",
      "max_tokens": 2000
    },
    "intent_parse": {
      "instructions": "modelfile",
      "primary_provider": "ollama",
      "max_tokens": 256
    },
    "task_match": {
      "instructions": "raw_prompt",
      "primary_provider": "ollama",
      "max_tokens": 64
    },
    "note_dedup": {
      "instructions": "raw_prompt",
      "primary_provider": "ollama",
      "max_tokens": 64
    }
  },
  "fallback_settings": {
    "default_mode": "auto",
    "notification_enabled": true,
    "notification_channels": [
      "cli"
    ],
    "log_fallbacks": true,
    "max_fallback_attempts": 1
  },
  "cost_tracking": {
    "enabled": true,
    "storage_path": "~/.workmain/cost_history.json",
    "track_per_section": true,
    "track_per_report": true,
    "alert_on_high_cost": true,
    "high_cost_threshold": 5.0,
    "monthly_budget": null
  },
  "advanced": {
    "context_window_management": {
      "enabled": true,
      "max_context_tokens": 180000,
      "truncation_strategy": "oldest_first"
    },
    "caching": {
      "enabled": false,
      "cache_prompts": false,
      "cache_duration_hours": 24
    }
  }
}